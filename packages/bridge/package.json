{
  "name": "yeoman-whatsapp-bridge",
  "version": "0.1.0",
  "description": "WhatsApp bridge for yeoman using Baileys",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && BRIDGE_MESSAGE_REFERENCE_DIR=\"${TMPDIR:-/tmp}/yeoman-bridge-test-references\" node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "git+https://github.com/WhiskeySockets/Baileys.git#fb16e3efffccad3cbdf8202eadbdfa566a80a062",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.17.1"
  },
  "overrides": {
    "protobufjs": "^7.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
