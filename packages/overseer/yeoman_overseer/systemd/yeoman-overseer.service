[Unit]
Description=Yeoman Overseer — autonomous orchestration layer
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300
OnFailure=yeoman-overseer-alert.service

[Service]
Type=notify
ExecStart=%h/.local/bin/yeoman overseer start --foreground
Restart=always
RestartSec=5
WatchdogSec=60

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
MemoryMax=512M
CPUQuota=80%

BindPaths=%h/.yeoman
ReadOnlyPaths=%h/Documents/yeoman

Environment=YEOMAN_HOME=%h/.yeoman
# Runbooks restart units via `systemctl --user`; without a runtime dir that fails with
# "Failed to connect to user scope bus", the runbook errors, and the service exits 1.
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=default.target
