[Unit]
Description=Yeoman Overseer — autonomous orchestration layer
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300
OnFailure=yeoman-overseer-alert.service

[Service]
Type=notify
ExecStart=%h/.local/bin/yeoman overseer start --foreground
Restart=always
RestartSec=5
WatchdogSec=60

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
MemoryMax=512M
CPUQuota=80%

BindPaths=%h/.yeoman
ReadOnlyPaths=%h/Documents/yeoman

Environment=YEOMAN_HOME=%h/.yeoman

[Install]
WantedBy=default.target
