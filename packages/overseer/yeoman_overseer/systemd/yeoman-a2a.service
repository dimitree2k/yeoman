[Unit]
Description=Yeoman A2A Relay — authenticated Hermes skill relay
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
ExecStart=%h/.local/bin/yeoman a2a serve
Restart=always
RestartSec=5

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=256M

BindPaths=%h/.yeoman
ReadOnlyPaths=%h/Documents/yeoman

Environment=YEOMAN_HOME=%h/.yeoman
EnvironmentFile=-%h/.yeoman/.env

[Install]
WantedBy=default.target
