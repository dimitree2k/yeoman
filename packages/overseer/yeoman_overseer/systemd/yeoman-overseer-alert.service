[Unit]
Description=Yeoman Overseer Alert — last-resort notification on overseer failure

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" -d chat_id="${TELEGRAM_OWNER_CHAT_ID}" -d text="🔴 OVERSEER DOWN: yeoman-overseer.service failed on $(hostname). Manual intervention required."'

EnvironmentFile=%h/.yeoman/.env
